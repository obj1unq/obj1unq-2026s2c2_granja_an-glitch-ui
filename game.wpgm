import wollok.game.*
import personaje.*
import granja.*
import cultivos.*
import direcciones.*
import mercado.*




program laGranja {
	//  CONFIG	
	game.title("La granja")
	game.height(10)
	game.width(10)
	game.ground("fondo.png")

	// AÑADIMIENTO DE COSAS
 	game.addVisualCharacter(personaje)
	game.addVisual(mercado)

	// ACCIONES
	//game.onCollideDo(personaje, {elem => elem.efectoPorColision()})

	// TECLAS
 	keyboard.g().onPressDo{personaje.cambiarGenero()}
	keyboard.m().onPressDo{granja.plantar(maiz, personaje.position())}
	keyboard.t().onPressDo{granja.plantar(trigo, personaje.position())}
	keyboard.o().onPressDo{granja.plantar(tomaco, personaje.position())}
	keyboard.r().onPressDo{granja.regar()}
	keyboard.c().onPressDo{granja.cosechar()}
	keyboard.space().onPressDo{game.say(personaje, "Tengo "+granja.plantasCosechadas().count()+" plantas para vender por $" +granja.totalAObtenerPorVenta()+ " monedas.")}
	keyboard.v().onPressDo{granja.vender()}

	keyboard.up().onPressDo{personaje.mover(arriba)} // :P
	keyboard.down().onPressDo{personaje.mover(abajo)}
	keyboard.left().onPressDo{personaje.mover(izquierda)}
	keyboard.right().onPressDo{personaje.mover(derecha)}

 	//  COMIENZA
	game.start()
}
